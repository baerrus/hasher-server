# BUILD.bazel generated from Makefile

config_setting(
    name = "darwin",
    constraint_values = ["@platforms//os:osx"],
)

cc_binary(
    name = "hasher-server",
    srcs = [
        "hasher-main.cpp",
        "hasher-server.cpp",
        "hasher-server.h",
        "client-connection.cpp",
        "client-connection.h",
        "hasher-stream.cpp",
        "hasher-stream.h",
        "hasher-config.cpp",
        "hasher-config.h",
        "buffer.cpp",
        "buffer.h",
        "shared_tracker.h",
    ],
    deps = [
        "@asio//:asio",
    ],
    copts = [
        "-O3",
        "-std=c++20",
        "-fvisibility=hidden",
    ] + select({
        ":darwin": [
            "-DMACOS",
        ],
        "//conditions:default": [],
    }),
    defines = [
        # Optionally add ASIO_ENABLE_HANDLER_TRACKING for debug
        # "ASIO_ENABLE_HANDLER_TRACKING",
    ],
    linkopts = [
        "-pthread",
    ] + select({
        ":darwin": [],
        "//conditions:default": [
            "-lcrypto",
            "-lrt",
        ],
    }),
)